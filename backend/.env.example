# ---- API ----
PORT=4000
# Comma-separated origins allowed to call the API (the portal's URL)
CORS_ORIGINS=http://localhost:3000
# Long random string; tokens are signed with it
JWT_SECRET=change-me
JWT_TTL_HOURS=12

# ---- Portal database (portal-owned data: users, requests, quotes, ...) ----
# mssql in production; sqlite for local development and tests
PORTAL_DB_CLIENT=mssql
PORTAL_DB_HOST=sqlserver.client.local
PORTAL_DB_PORT=1433
PORTAL_DB_NAME=NexusPortal
PORTAL_DB_USER=nexus_portal
PORTAL_DB_PASSWORD=
PORTAL_DB_ENCRYPT=true
PORTAL_DB_TRUST_CERT=false
# PORTAL_DB_CLIENT=sqlite
# PORTAL_DB_FILE=./data/portal.db

# ---- Sage X3 ----
# live: read the X3 database through the NX_* views, write through X3 web services
# sim:  a simulated X3 database (same tables and views) for development and tests
X3_MODE=live
X3_DB_CLIENT=mssql
X3_DB_HOST=sqlserver.client.local
X3_DB_PORT=1433
X3_DB_NAME=x3erpv12
# Read-only login with SELECT on the NEXUS schema only
X3_DB_USER=nexus_reader
X3_DB_PASSWORD=
X3_DB_ENCRYPT=true
X3_DB_TRUST_CERT=false
# X3 folder schema (tables) and the schema holding the NX_* views
X3_FOLDER_SCHEMA=SEED
X3_VIEW_SCHEMA=NEXUS
# X3 SOAP web services (CAdxWebServiceXmlCC)
X3_WS_URL=https://x3.client.local:8124/soap-generic/syracuse/collaboration/syracuse/CAdxWebServiceXmlCC
X3_WS_POOL=NEXUS
X3_WS_USER=nexus_ws
X3_WS_PASSWORD=
X3_WS_LANG=ENG
X3_WS_TIMEOUT_MS=30000
# X3_DB_CLIENT=sqlite
# X3_DB_FILE=./data/x3sim.db

# Seed demo data when the portal database is empty (development only)
SEED_DEMO=false
